<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Library" targetNamespace="urn:bpmn-ai-lab:library">
  <bpmn:message id="mBookRequest" />
  <bpmn:message id="mCorrectionRequest" />
  <bpmn:message id="mCorrectedDetails" />
  <bpmn:message id="mUnavailable" />
  <bpmn:message id="mApproval" />
  <bpmn:message id="mHandover" />
  <bpmn:message id="mReturn" />
  <bpmn:collaboration id="Collaboration_Library">
    <bpmn:participant id="Pool_Student" name="Student" processRef="Process_Student" />
    <bpmn:participant id="Pool_Library" name="Library" processRef="Process_Library" />
    <bpmn:messageFlow id="mfRequest" name="Book request" sourceRef="stSendRequest" targetRef="liReceiveRequest" messageRef="mBookRequest" />
    <bpmn:messageFlow id="mfCorrection" name="Correction request" sourceRef="liSendCorrection" targetRef="stReceiveCorrection" messageRef="mCorrectionRequest" />
    <bpmn:messageFlow id="mfCorrected" name="Corrected details" sourceRef="stSendCorrected" targetRef="liReceiveCorrected" messageRef="mCorrectedDetails" />
    <bpmn:messageFlow id="mfUnavailable" name="Unavailable notice" sourceRef="liSendUnavailable" targetRef="stReceiveUnavailable" messageRef="mUnavailable" />
    <bpmn:messageFlow id="mfApproval" name="Approval" sourceRef="liSendApproval" targetRef="stReceiveApproval" messageRef="mApproval" />
    <bpmn:messageFlow id="mfHandover" name="Book handover" sourceRef="liSendBook" targetRef="stReceiveBook" messageRef="mHandover" />
    <bpmn:messageFlow id="mfReturn" name="Book return" sourceRef="stSendReturn" targetRef="liReceiveReturn" messageRef="mReturn" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Student" name="Student" isExecutable="false">
    <bpmn:startEvent id="stStart" name="Start">
      <bpmn:outgoing>st1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="stPrepare" name="Prepare book request">
      <bpmn:incoming>st1</bpmn:incoming>
      <bpmn:outgoing>st2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="stSendRequest" name="Send book request" messageRef="mBookRequest">
      <bpmn:incoming>st2</bpmn:incoming>
      <bpmn:outgoing>st3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="stReceiveDecision" name="Receive library response">
      <bpmn:incoming>st3</bpmn:incoming>
      <bpmn:incoming>stLoop</bpmn:incoming>
      <bpmn:outgoing>st4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="stRoute" name="Response type?" gatewayDirection="Diverging">
      <bpmn:incoming>st4</bpmn:incoming>
      <bpmn:outgoing>stCorrectionPath</bpmn:outgoing>
      <bpmn:outgoing>stUnavailablePath</bpmn:outgoing>
      <bpmn:outgoing>stApprovedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="stReceiveCorrection" name="Receive correction request" messageRef="mCorrectionRequest">
      <bpmn:incoming>stCorrectionPath</bpmn:incoming>
      <bpmn:outgoing>st5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:subProcess id="stCorrect" name="Correct request details">
      <bpmn:incoming>st5</bpmn:incoming>
      <bpmn:outgoing>stAfterCorrect</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics>
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">detailsNeedCorrection = true</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
      <bpmn:startEvent id="stcStart" name="Start">
        <bpmn:outgoing>stc_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="stcEdit" name="Correct request details">
        <bpmn:incoming>stc_f1</bpmn:incoming>
        <bpmn:outgoing>stc_f2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="stcEnd" name="Details corrected">
        <bpmn:incoming>stc_f2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="stc_f1" sourceRef="stcStart" targetRef="stcEdit" />
      <bpmn:sequenceFlow id="stc_f2" sourceRef="stcEdit" targetRef="stcEnd" />
    </bpmn:subProcess>
    <bpmn:sendTask id="stSendCorrected" name="Resubmit corrected details" messageRef="mCorrectedDetails">
      <bpmn:incoming>stAfterCorrect</bpmn:incoming>
      <bpmn:outgoing>stLoop</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="st5" sourceRef="stReceiveCorrection" targetRef="stCorrect" />
    <bpmn:sequenceFlow id="stAfterCorrect" sourceRef="stCorrect" targetRef="stSendCorrected" />
    <bpmn:sequenceFlow id="stLoop" sourceRef="stSendCorrected" targetRef="stReceiveDecision" />
    <bpmn:receiveTask id="stReceiveUnavailable" name="Receive unavailable notice" messageRef="mUnavailable">
      <bpmn:incoming>stUnavailablePath</bpmn:incoming>
      <bpmn:outgoing>st6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="stUnavailableEnd" name="Request unavailable">
      <bpmn:incoming>st6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="st6" sourceRef="stReceiveUnavailable" targetRef="stUnavailableEnd" />
    <bpmn:receiveTask id="stReceiveApproval" name="Receive approval" messageRef="mApproval">
      <bpmn:incoming>stApprovedPath</bpmn:incoming>
      <bpmn:outgoing>st7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="stReceiveBook" name="Receive book" messageRef="mHandover">
      <bpmn:incoming>st7</bpmn:incoming>
      <bpmn:outgoing>st8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="stUseBook" name="Use book">
      <bpmn:incoming>st8</bpmn:incoming>
      <bpmn:outgoing>st9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="stSendReturn" name="Return book" messageRef="mReturn">
      <bpmn:incoming>st9</bpmn:incoming>
      <bpmn:outgoing>st10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="stEnd" name="Loan complete">
      <bpmn:incoming>st10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="st1" sourceRef="stStart" targetRef="stPrepare" />
    <bpmn:sequenceFlow id="st2" sourceRef="stPrepare" targetRef="stSendRequest" />
    <bpmn:sequenceFlow id="st3" sourceRef="stSendRequest" targetRef="stReceiveDecision" />
    <bpmn:sequenceFlow id="st4" sourceRef="stReceiveDecision" targetRef="stRoute" />
    <bpmn:sequenceFlow id="stCorrectionPath" name="correction" sourceRef="stRoute" targetRef="stReceiveCorrection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">responseType = "correction"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="stUnavailablePath" name="unavailable" sourceRef="stRoute" targetRef="stReceiveUnavailable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">responseType = "unavailable"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="stApprovedPath" name="approved" sourceRef="stRoute" targetRef="stReceiveApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">responseType = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="st7" sourceRef="stReceiveApproval" targetRef="stReceiveBook" />
    <bpmn:sequenceFlow id="st8" sourceRef="stReceiveBook" targetRef="stUseBook" />
    <bpmn:sequenceFlow id="st9" sourceRef="stUseBook" targetRef="stSendReturn" />
    <bpmn:sequenceFlow id="st10" sourceRef="stSendReturn" targetRef="stEnd" />
  </bpmn:process>
  <bpmn:process id="Process_Library" name="Library" isExecutable="false">
    <bpmn:laneSet id="Library_Lanes">
      <bpmn:lane id="Lane_Librarian" name="Librarian">
        <bpmn:flowNodeRef>liStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liSendUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liUnavailableEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liDetailsX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liSendCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liReceiveCorrected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liReviewAgain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liSendApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liRecordLoan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liSendBook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liReceiveReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liCheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>liEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="liStart" name="Start">
      <bpmn:outgoing>li1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="liReceiveRequest" name="Receive book request" messageRef="mBookRequest">
      <bpmn:incoming>li1</bpmn:incoming>
      <bpmn:outgoing>li2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="liAvailability" name="Book available?" gatewayDirection="Diverging">
      <bpmn:incoming>li2</bpmn:incoming>
      <bpmn:outgoing>liNo</bpmn:outgoing>
      <bpmn:outgoing>liYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="liSendUnavailable" name="Send unavailable notice" messageRef="mUnavailable">
      <bpmn:incoming>liNo</bpmn:incoming>
      <bpmn:outgoing>li3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="liUnavailableEnd" name="Request unavailable">
      <bpmn:incoming>li3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="liValidate" name="Validate request details">
      <bpmn:incoming>liYes</bpmn:incoming>
      <bpmn:incoming>liReviewAgainOut</bpmn:incoming>
      <bpmn:outgoing>li4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="liDetailsX" name="Details valid?" gatewayDirection="Diverging">
      <bpmn:incoming>li4</bpmn:incoming>
      <bpmn:outgoing>liNeedsCorrection</bpmn:outgoing>
      <bpmn:outgoing>liValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="liSendCorrection" name="Request detail correction" messageRef="mCorrectionRequest">
      <bpmn:incoming>liNeedsCorrection</bpmn:incoming>
      <bpmn:outgoing>li5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="liReceiveCorrected" name="Receive corrected details" messageRef="mCorrectedDetails">
      <bpmn:incoming>li5</bpmn:incoming>
      <bpmn:outgoing>liReviewAgainFlow</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="liReviewAgain" name="Review corrected details">
      <bpmn:incoming>liReviewAgainFlow</bpmn:incoming>
      <bpmn:outgoing>liReviewAgainOut</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="liReviewAgainFlow" sourceRef="liReceiveCorrected" targetRef="liReviewAgain" />
    <bpmn:sequenceFlow id="liReviewAgainOut" sourceRef="liReviewAgain" targetRef="liValidate" />
    <bpmn:sendTask id="liSendApproval" name="Send approval" messageRef="mApproval">
      <bpmn:incoming>li6</bpmn:incoming>
      <bpmn:outgoing>li7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="liRecordLoan" name="Record loan and due date">
      <bpmn:incoming>liValid</bpmn:incoming>
      <bpmn:outgoing>li6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="liSendBook" name="Hand over book" messageRef="mHandover">
      <bpmn:incoming>li7</bpmn:incoming>
      <bpmn:outgoing>li8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="liReceiveReturn" name="Check in returned book" messageRef="mReturn">
      <bpmn:incoming>li8</bpmn:incoming>
      <bpmn:outgoing>li9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="liCheckIn" name="Complete book check-in">
      <bpmn:incoming>li9</bpmn:incoming>
      <bpmn:outgoing>li10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="liEnd" name="Loan closed">
      <bpmn:incoming>li10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="li1" sourceRef="liStart" targetRef="liReceiveRequest" />
    <bpmn:sequenceFlow id="li2" sourceRef="liReceiveRequest" targetRef="liAvailability" />
    <bpmn:sequenceFlow id="liNo" name="unavailable" sourceRef="liAvailability" targetRef="liSendUnavailable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">available = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="liYes" name="available" sourceRef="liAvailability" targetRef="liValidate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">available = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="li3" sourceRef="liSendUnavailable" targetRef="liUnavailableEnd" />
    <bpmn:sequenceFlow id="li4" sourceRef="liValidate" targetRef="liDetailsX" />
    <bpmn:sequenceFlow id="liNeedsCorrection" name="needs correction" sourceRef="liDetailsX" targetRef="liSendCorrection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">detailsValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="liValid" name="valid" sourceRef="liDetailsX" targetRef="liRecordLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">detailsValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="li5" sourceRef="liSendCorrection" targetRef="liReceiveCorrected" />
    <bpmn:sequenceFlow id="li6" sourceRef="liRecordLoan" targetRef="liSendApproval" />
    <bpmn:sequenceFlow id="li7" sourceRef="liSendApproval" targetRef="liSendBook" />
    <bpmn:sequenceFlow id="li8" sourceRef="liSendBook" targetRef="liReceiveReturn" />
    <bpmn:sequenceFlow id="li9" sourceRef="liReceiveReturn" targetRef="liCheckIn" />
    <bpmn:sequenceFlow id="li10" sourceRef="liCheckIn" targetRef="liEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Library">
    <bpmndi:BPMNPlane id="Plane_Library" bpmnElement="Collaboration_Library">
      <bpmndi:BPMNShape id="shPoolStudent" bpmnElement="Pool_Student">
        <dc:Bounds x="50" y="50" width="3710" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shPoolLibrary" bpmnElement="Pool_Library">
        <dc:Bounds x="50" y="700" width="3710" height="470" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shLaneLibrarian" bpmnElement="Lane_Librarian">
        <dc:Bounds x="70" y="710" width="3670" height="450" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stStart" bpmnElement="stStart">
        <dc:Bounds x="140" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stPrepare" bpmnElement="stPrepare">
        <dc:Bounds x="230" y="188" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stSendRequest" bpmnElement="stSendRequest">
        <dc:Bounds x="420" y="188" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stReceiveDecision" bpmnElement="stReceiveDecision">
        <dc:Bounds x="650" y="188" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stRoute" bpmnElement="stRoute">
        <dc:Bounds x="870" y="203" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stReceiveCorrection" bpmnElement="stReceiveCorrection">
        <dc:Bounds x="1010" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stCorrect" bpmnElement="stCorrect" isExpanded="true">
        <dc:Bounds x="1230" y="65" width="480" height="135" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stcStart" bpmnElement="stcStart">
        <dc:Bounds x="1250" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stcEdit" bpmnElement="stcEdit">
        <dc:Bounds x="1310" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stSendCorrected" bpmnElement="stSendCorrected">
        <dc:Bounds x="1840" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stcEnd" bpmnElement="stcEnd">
        <dc:Bounds x="1640" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stReceiveUnavailable" bpmnElement="stReceiveUnavailable">
        <dc:Bounds x="1010" y="210" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stUnavailableEnd" bpmnElement="stUnavailableEnd">
        <dc:Bounds x="1270" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stReceiveApproval" bpmnElement="stReceiveApproval">
        <dc:Bounds x="1010" y="320" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stReceiveBook" bpmnElement="stReceiveBook">
        <dc:Bounds x="1240" y="320" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stUseBook" bpmnElement="stUseBook">
        <dc:Bounds x="1500" y="320" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stSendReturn" bpmnElement="stSendReturn">
        <dc:Bounds x="1740" y="320" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_stEnd" bpmnElement="stEnd">
        <dc:Bounds x="1940" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liStart" bpmnElement="liStart">
        <dc:Bounds x="140" y="900" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liReceiveRequest" bpmnElement="liReceiveRequest">
        <dc:Bounds x="230" y="878" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liAvailability" bpmnElement="liAvailability">
        <dc:Bounds x="450" y="893" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liSendUnavailable" bpmnElement="liSendUnavailable">
        <dc:Bounds x="600" y="750" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liUnavailableEnd" bpmnElement="liUnavailableEnd">
        <dc:Bounds x="820" y="772" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liValidate" bpmnElement="liValidate">
        <dc:Bounds x="600" y="895" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liDetailsX" bpmnElement="liDetailsX">
        <dc:Bounds x="820" y="910" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liSendCorrection" bpmnElement="liSendCorrection">
        <dc:Bounds x="970" y="750" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liReceiveCorrected" bpmnElement="liReceiveCorrected">
        <dc:Bounds x="1190" y="750" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liReviewAgain" bpmnElement="liReviewAgain">
        <dc:Bounds x="1400" y="750" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liSendApproval" bpmnElement="liSendApproval">
        <dc:Bounds x="1190" y="895" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liRecordLoan" bpmnElement="liRecordLoan">
        <dc:Bounds x="970" y="895" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liSendBook" bpmnElement="liSendBook">
        <dc:Bounds x="1420" y="895" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liReceiveReturn" bpmnElement="liReceiveReturn">
        <dc:Bounds x="1640" y="895" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liCheckIn" bpmnElement="liCheckIn">
        <dc:Bounds x="1880" y="895" width="155" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_liEnd" bpmnElement="liEnd">
        <dc:Bounds x="2110" y="917" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_st1" bpmnElement="st1">
        <di:waypoint x="176" y="228" />
        <di:waypoint x="230" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_st2" bpmnElement="st2">
        <di:waypoint x="360" y="228" />
        <di:waypoint x="420" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_st3" bpmnElement="st3">
        <di:waypoint x="550" y="228" />
        <di:waypoint x="650" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_st4" bpmnElement="st4">
        <di:waypoint x="800" y="228" />
        <di:waypoint x="870" y="228" />
